    "current"|"disappeared"|"new"|"search_engines_orphans"|"gsc_keywords"|"gsc_keywords_by_country" area = "current";
    # Include deprecated fields
    @http:Query {name: "deprecated_fields"}
    boolean deprecatedFields = true;
    # Previous analysis identifier
    @http:Query {name: "previous_crawl"}
    string previousCrawl?;
    # Whether to use sequenced groups
    boolean sequenced = false;
};

