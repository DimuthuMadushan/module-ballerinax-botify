# Represents the Queries record for the operation: getProjectUrlsAggs
public type GetProjectUrlsAggsQueries record {
    # Analyses context
    "current"|"disappeared"|"new"|"gsc_keywords"|"gsc_keywords_by_country" area = "current";
    # Last analysis on the trend
    @http:Query {name: "last_analysis_slug"}
    string lastAnalysisSlug?;
    # Max number of analysis to return
    @http:Query {name: "nb_analyses"}
    int:Signed32 nbAnalyses = 20;
};

