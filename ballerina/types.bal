    # Whether to use sequenced groups
    boolean sequenced = false;
};

public type LightAnalysis record {
    @jsondata:Name {value: "friendly_name"}
    string friendlyName?;
    @jsondata:Name {value: "urls_in_queue"}
    string urlsInQueue?;
    # If yes, this crawl has raw HTML pages
    @jsondata:Name {value: "has_raw_pages"}
    boolean hasRawPages?;
    @jsondata:Name {value: "date_created"}
    string dateCreated?;
    # If yes, this crawl will be excluded from trends data
    @jsondata:Name {value: "excluded_from_trends"}
    boolean excludedFromTrends?;
    @jsondata:Name {value: "urls_done"}
    string urlsDone?;
    @jsondata:Name {value: "to_be_deleted_at"}
    string toBeDeletedAt?;
    string url?;
    @jsondata:Name {value: "date_finished"}
    string dateFinished?;
    string name?;
    string pk?;
    boolean comparable = true;
    string slug;
    @jsondata:Name {value: "date_launched"}
    string dateLaunched?;
    # Date of last modified analysis
    @jsondata:Name {value: "date_last_modified"}
    string dateLastModified?;
    string status?;
};

public type UrlsAggsResponse record {
};

public type UrlsExportsList record {
    string next?;
    string previous?;
    int size?;
    int count?;
    int page?;
    CsvExportStatus[] results?;
};

# Project's saved UrlFilter
public type ProjectSavedFilter record {
    # Identifier of the saved filter
    string identifier?;
    # Name of the saved filter
    string name;
    # Description of the saved filter
    string description?;
    # Filter expression stored in the saved filter
    record {} filters;
    # Date and time the saved filter was created
    @jsondata:Name {value: "created_date"}
    string createdDate?;
    # Type of the saved filter
    string 'type?;
    # Name of the project the filter belongs to
    @jsondata:Name {value: "project_name"}
    string projectName?;
};

public type CollectionMetadata record {
    @jsondata:Name {value: "date_start"}
    string dateStart?;
    @jsondata:Name {value: "date_end"}
    string dateEnd?;
    record {} config?;
    @jsondata:Name {value: "date_last_modified"}
    string dateLastModified?;
};

